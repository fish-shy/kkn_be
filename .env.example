# =============================================================== Supabase ===
# Semuanya diambil dari satu proyek Supabase: basis data + penyimpanan gambar.
# Buat proyek gratis di https://supabase.com, lalu isi nilai di bawah.

# --- Basis data ---
# Supabase Dashboard → Connect (tombol di atas) → ORM → Prisma.
# Di sana tersedia dua alamat; salin keduanya apa adanya.
#
#   DATABASE_URL = Transaction pooler, port 6543, berakhiran ?pgbouncer=true
#   DIRECT_URL   = Direct connection / Session pooler, port 5432
#
# Ganti [YOUR-PASSWORD] dengan kata sandi basis data proyek (yang dibuat saat
# proyek pertama kali dibuat, bukan kata sandi akun Supabase).
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Penyimpanan gambar ---
# Dashboard → Settings → API.
#   SUPABASE_URL              = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role (RAHASIA — jangan pernah dipakai
#                               di frontend atau ikut masuk repo)
# Lalu buat bucket di Dashboard → Storage → New bucket, nama `gambar`,
# centang "Public bucket" supaya gambarnya bisa tampil di situs.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ganti-dengan-service-role-key"
SUPABASE_BUCKET="gambar"

# ================================================================= Server ===
PORT=4000
# Origin frontend yang boleh memanggil API. Pisahkan dengan koma bila lebih
# dari satu (mis. dev Vite + domain produksi).
CORS_ORIGIN="http://localhost:5173"

# =================================================================== Auth ===
# WAJIB diganti dengan string acak panjang sebelum dipublikasikan.
# Bangkitkan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
JWT_EXPIRES_IN="12h"

# Akun admin awal — dibuat oleh `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ubah-password-ini"
ADMIN_NAMA="Administrator Kelurahan"

# ================================================================= Unggah ===
# Batas ukuran berkas gambar dalam megabyte.
UPLOAD_MAX_MB=5
